# =============================================================================
# Swasti Homoeo Clinic — Apache / LiteSpeed configuration
# Target: Hostinger Business shared hosting
# No custom Apache modules required. Everything below is safe on Hostinger hPanel.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Default index files
#    The front end is static HTML, so index.html must win over index.php.
# -----------------------------------------------------------------------------
DirectoryIndex index.html index.php

# -----------------------------------------------------------------------------
# 2. Method restrictions — the application only needs GET, HEAD and POST.
#    This runs before every other rewrite rule so it cannot be bypassed by
#    the clean-URL rules further down.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_METHOD} ^(TRACE|TRACK|DEBUG|CONNECT|PUT|DELETE|PATCH)$
    RewriteRule .* - [F,L]
</IfModule>

# -----------------------------------------------------------------------------
# 3. HTTPS — force all public traffic to HTTPS
#    Only active once Hostinger's free certificate is issued for the domain.
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Hostinger sets X-Forwarded-Proto; this also covers LiteSpeed.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1|\[::1\])(:%{HTTP_PORT})?$
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# -----------------------------------------------------------------------------
# 4. Static front end, PHP back end
#
#    Public pages are plain .html files generated by tools/build-pages.php.
#    PHP is only reached for the admin panel and a few dynamic endpoints, so
#    visitors never wait on PHP for content. Order matters here:
#      1. never expose the front controller
#      2. serve real files as-is (assets, api/*.php, robots.txt, sitemap.xml)
#      3. /about-us        -> about-us.html
#         /articles/slug   -> articles/slug.html
#      4. admin + dynamic endpoints -> index.php
#      5. anything else -> the static 404 page (see ErrorDocument below)
# -----------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. The front controller is never a valid public URL.
    RewriteRule ^index\.php$ - [R=404,L]

    # 2. Real files and directories are served directly. This is what makes
    #    /api/booking.php, /api/csrf.php, /favicon.ico, /robots.txt,
    #    /sitemap.xml and /site.webmanifest work with zero PHP.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Clean URL -> static page. OPTIONS * MultiViews is off, so this is
    #    the only place extensionless URLs are resolved.
    RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}.html -f
    RewriteRule ^ %{REQUEST_URI}.html [L]

    # 4. The remaining PHP routes.
    RewriteRule ^admin(/.*)?$   index.php [L]
    RewriteRule ^(faqs\.json|health)$ index.php [L]

    # 5. Forms post to the JSON endpoints, never to a page URL. Answer 405
    #    rather than a confusing 404 if something tries anyway.
    RewriteCond %{REQUEST_METHOD} =POST
    RewriteRule ^(book-consultation|book-follow-up|contact)$ - [R=405,L]
</IfModule>

# The static 404 page, returned with a real 404 status.
ErrorDocument 404 /404.html

# -----------------------------------------------------------------------------
# 5. Block dotfiles and sensitive files
#    (.env, .git, .htpasswd, SQL, logs, backups, source files)
# -----------------------------------------------------------------------------
<FilesMatch "(^\.|\.(env|example|sql|sql\.gz|bak|backup|old|log|ini|sh|jsonl|lock|yml|yaml|dist|toml|conf)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Explicit belt-and-braces for the classic probe targets.
<Files ".env">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</Files>

# -----------------------------------------------------------------------------
# 6. Application directories that must never be served
#    Needed for the single-folder (self-contained) deployment mode where
#    app/, config/, views/, database/ and storage/ live inside public_html.
#    In the recommended layout they sit one level up and are already unreachable.
#    PHP-side guards (public_html/index.php) repeat this check, so the rule
#    holds even if mod_alias is unavailable.
# -----------------------------------------------------------------------------
RedirectMatch 404 ^/(app|config|views|database|storage|logs|sessions|backups|tests?|tools|vendor)(/|$)
RedirectMatch 404 ^/\.(git|svn|hg|env)(/|$)

# -----------------------------------------------------------------------------
# 7. No directory listing, no CGI, no server-side includes
# -----------------------------------------------------------------------------
Options -Indexes -MultiViews +FollowSymLinks
Options -ExecCGI -Includes
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# -----------------------------------------------------------------------------
# 8. Character encoding
# -----------------------------------------------------------------------------
AddDefaultCharset UTF-8
AddType "text/css; charset=UTF-8"                .css
AddType "application/javascript; charset=UTF-8"  .js
AddType "image/svg+xml"                          .svg
AddType "image/webp"                             .webp
AddType "application/manifest+json"              .webmanifest
AddType "application/xml; charset=UTF-8"         .xml
AddType "text/xml; charset=UTF-8"                .xml

# -----------------------------------------------------------------------------
# 9. Compression (mod_deflate; LiteSpeed ignores this harmlessly)
# -----------------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
</IfModule>

# -----------------------------------------------------------------------------
# 10. Browser caching
#     Assets are cache-busted with ?v=<mtime> so a long max-age is safe.
#     HTML is never cached here — PHP sends Cache-Control per response.
# -----------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png            "access plus 1 year"
    ExpiresByType image/jpeg           "access plus 1 year"
    ExpiresByType image/webp           "access plus 1 year"
    ExpiresByType image/svg+xml        "access plus 1 year"
    ExpiresByType image/x-icon         "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"
    ExpiresByType font/woff            "access plus 1 year"
    ExpiresByType font/woff2           "access plus 1 year"
    ExpiresByType text/css             "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/manifest+json "access plus 7 days"
    ExpiresByType application/json     "access plus 1 hour"
    ExpiresByType application/xml      "access plus 1 day"
    ExpiresByType text/xml             "access plus 1 day"
    ExpiresByType text/html            "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|ico|woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(xml|json|webmanifest|txt)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
    Header unset X-Powered-By
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# -----------------------------------------------------------------------------
# 10b. Security headers for the static pages
#      PHP responses set their own CSP (they hash per-request inline scripts),
#      so this block is scoped to .html files and cannot weaken the admin
#      panel. Every script on a static page is an external file or a
#      non-executable application/ld+json block, so 'self' is enough.
# -----------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.html$">
        Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://wa.me; img-src 'self' data:; font-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
        Header always set X-Frame-Options "SAMEORIGIN"
        Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        Header always set Cross-Origin-Opener-Policy "same-origin"
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    </FilesMatch>
</IfModule>

# -----------------------------------------------------------------------------
# 11. MIME types that Apache sometimes misses on shared hosting
# -----------------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType image/svg+xml         .svg
    AddType image/webp            .webp
    AddType image/avif            .avif
    AddType font/woff             .woff
    AddType font/woff2            .woff2
    AddType application/manifest+json .webmanifest
</IfModule>

# -----------------------------------------------------------------------------
# 12. Server signature
# -----------------------------------------------------------------------------
ServerSignature Off
