# =============================================================================
# Swasti Homoeo Clinic — environment configuration
# =============================================================================
# Copy this file to ".env" and fill in the real values.
# On Hostinger you may create the file directly in File Manager and rename
# it to ".env" (make sure "Show Hidden Files" is switched ON).
#
# The .env file MUST never be publicly downloadable. The shipped .htaccess
# rules block it with a 403 even in the single-folder deployment mode.
# =============================================================================

# --- Application -----------------------------------------------------------
# Use "production" once the site is live. debug=true prints raw error output.
APP_ENV=production
APP_DEBUG=false
APP_URL=https://swastihomoeo.com
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en_IN

# Base URL of the PHP form backend. Leave EMPTY when the site and the API share
# a domain (the normal Hostinger setup). Set it to the PHP host when the static
# pages are served from Vercel and the forms post back to Hostinger:
#   API_BASE_URL=https://swastihomoeo.com
API_BASE_URL=

# Optional random string (32+ chars). Used to sign session cookies and to
# generate non-guessable reference codes. Generate one in hPanel or with:
#   php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --- Database (Hostinger MySQL / MariaDB) -----------------------------------
# Create the database in hPanel: Websites -> Databases -> Management.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u123456789_swasti
DB_USERNAME=u123456789_swasti
DB_PASSWORD=CHANGE_ME
DB_CHARSET=utf8mb4

# Optional: unix socket path, only if your host requires it.
# DB_SOCKET=

# --- Mail (SMTP) -----------------------------------------------------------
# Hostinger SMTP example:  smtp.hostinger.com / 465 (ssl) or 587 (tls)
# Leave MAIL_HOST empty to disable email. Submissions are still stored in the
# database (and in storage/submissions/*.jsonl as a fallback) and are never
# lost because a mail server is unavailable.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@swastihomeo.com
MAIL_FROM_NAME=Swasti Homoeo Clinic
MAIL_REPLY_TO=info@swastihomeo.com
MAIL_TO_ADDRESS=info@swastihomeo.com
MAIL_CC=

# --- Admin account ---------------------------------------------------------
# Generate the hash with:
#   php -r "echo password_hash('your-password', PASSWORD_DEFAULT), PHP_EOL;"
# Then paste the output below. Leave ADMIN_PASSWORD_HASH empty to use the
# first user row created by database/seed.sql.
ADMIN_NAME=Clinic Administrator
ADMIN_EMAIL=info@swastihomeo.com
ADMIN_PASSWORD_HASH=

# --- Clinic contact details ------------------------------------------------
CLINIC_PHONE=+917980644867
CLINIC_WHATSAPP=917980644867
CLINIC_EMAIL=info@swastihomeo.com
CLINIC_FACEBOOK=
CLINIC_INSTAGRAM=
CLINIC_X=
CLINIC_YOUTUBE=
